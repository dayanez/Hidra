<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>HidWizards.UCR</RootNamespace>
    <AssemblyName>UCR</AssemblyName>
    <ApplicationIcon>UCR.ico</ApplicationIcon>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MaterialDesignColors" Version="3.1.0" />
    <PackageReference Include="MaterialDesignThemes" Version="5.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UCR.Core\UCR.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Design-time-only sample data (root elements are ViewModel types, not Window/UserControl/Page) -
         must not go through the XAML markup compiler. -->
    <Page Remove="SampleData\**\*.xaml" />
    <None Include="SampleData\**\*.xaml" />
  </ItemGroup>

</Project>
