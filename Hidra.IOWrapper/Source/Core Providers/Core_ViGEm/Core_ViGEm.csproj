<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>Core_ViGEm</RootNamespace>
    <AssemblyName>Core_ViGEm</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Nullable>disable</Nullable>
    <!-- This is loaded as a MEF plugin, not project-referenced by the app, so its own
         NuGet dependency (Nefarius.ViGEm.Client) must be copied locally too. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.ComponentModel.Composition" Version="8.0.0" />
    <PackageReference Include="Nefarius.ViGEm.Client" Version="1.21.256" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\Core.csproj" />
    <ProjectReference Include="..\..\DataObjects\DTOs.csproj" />
    <ProjectReference Include="..\..\Provider Libraries\ProviderLogger\ProviderLogger.csproj" />
    <ProjectReference Include="..\..\ProviderInterface\ProviderInterface.csproj" />
  </ItemGroup>

  <Target Name="CopyToProvidersFolder" AfterTargets="Build">
    <PropertyGroup>
      <UcrAppProvidersDir>$(MSBuildThisFileDirectory)..\..\..\..\UCR\bin\$(Configuration)\$(TargetFramework)\Providers\$(TargetName)\</UcrAppProvidersDir>
    </PropertyGroup>
    <ItemGroup>
      <ProviderOutputFiles Include="$(TargetDir)*.dll" />
      <ProviderOutputFiles Include="$(TargetDir)*.pdb" Condition="'$(Configuration)' == 'Debug'" />
    </ItemGroup>
    <MakeDir Directories="$(UcrAppProvidersDir)" Condition="!Exists('$(UcrAppProvidersDir)')" />
    <Copy SourceFiles="@(ProviderOutputFiles)" DestinationFolder="$(UcrAppProvidersDir)" />
  </Target>

</Project>
