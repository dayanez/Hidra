<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>Core_Interception</RootNamespace>
    <AssemblyName>Core_Interception</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Nullable>disable</Nullable>
    <!-- This is loaded as a MEF plugin, not project-referenced by the app, so its own
         NuGet dependencies (and HidDeviceHelper's HidSharp) must be copied locally too. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.ComponentModel.Composition" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\DataObjects\DTOs.csproj" />
    <ProjectReference Include="..\..\Provider Libraries\Device Querying\DeviceLibrary\DeviceLibrary.csproj" />
    <ProjectReference Include="..\..\Provider Libraries\Device Querying\HidDeviceHelper\HidDeviceHelper.csproj" />
    <ProjectReference Include="..\..\Provider Libraries\Device Update Handling\DeviceHandlers\DeviceHandlers.csproj" />
    <ProjectReference Include="..\..\Provider Libraries\ProviderLogger\ProviderLogger.csproj" />
    <ProjectReference Include="..\..\Provider Libraries\Subscription Handling\SubscriptionHandler\SubscriptionHandler.csproj" />
    <ProjectReference Include="..\..\ProviderInterface\ProviderInterface.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Settings.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <Target Name="CopyToProvidersFolder" AfterTargets="Build">
    <PropertyGroup>
      <HidraAppProvidersDir>$(MSBuildThisFileDirectory)..\..\..\..\Hidra\bin\$(Configuration)\$(TargetFramework)\Providers\$(TargetName)\</HidraAppProvidersDir>
    </PropertyGroup>
    <ItemGroup>
      <ProviderOutputFiles Include="$(TargetDir)*.dll" />
      <ProviderOutputFiles Include="$(TargetDir)*.pdb" Condition="'$(Configuration)' == 'Debug'" />
      <ProviderOutputFiles Include="$(TargetDir)Settings.xml" Condition="Exists('$(TargetDir)Settings.xml')" />
    </ItemGroup>
    <MakeDir Directories="$(HidraAppProvidersDir)" Condition="!Exists('$(HidraAppProvidersDir)')" />
    <Copy SourceFiles="@(ProviderOutputFiles)" DestinationFolder="$(HidraAppProvidersDir)" />
  </Target>

</Project>
