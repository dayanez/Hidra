<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Hidra.Plugins</RootNamespace>
    <AssemblyName>Hidra.Plugins</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hidra.Core\Hidra.Core.csproj" />
  </ItemGroup>

  <Target Name="CopyToPluginsFolder" AfterTargets="Build">
    <PropertyGroup>
      <HidraAppPluginsDir>$(MSBuildThisFileDirectory)..\Hidra\bin\$(Configuration)\$(TargetFramework)\Plugins\$(TargetName)\</HidraAppPluginsDir>
    </PropertyGroup>
    <ItemGroup>
      <PluginOutputFiles Include="$(TargetDir)$(TargetName).dll" />
      <PluginOutputFiles Include="$(TargetDir)$(TargetName).pdb" Condition="'$(Configuration)' == 'Debug' AND Exists('$(TargetDir)$(TargetName).pdb')" />
    </ItemGroup>
    <MakeDir Directories="$(HidraAppPluginsDir)" Condition="!Exists('$(HidraAppPluginsDir)')" />
    <Copy SourceFiles="@(PluginOutputFiles)" DestinationFolder="$(HidraAppPluginsDir)" />
  </Target>

</Project>
